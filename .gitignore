# .gitignore for Keyarch

# Binaries
/keyarch
keyarch-*
*.exe
*.dll
*.so
*.dylib

# Test binaries
*.test

# Output of the go coverage tool
*.out
coverage.txt

# Go workspace file
go.work

# Dependency directories
vendor/

# IDE specific files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
dist/
build/
release/

# Local data (user's personal data)
*.db
*.db-journal
.keyarch/

# Logs
*.log

# Temporary files
tmp/
temp/

# Air live reload
.air.toml
tmp/
